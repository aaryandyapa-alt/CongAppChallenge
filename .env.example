# Copy this file to .env.local (which git ignores) and fill in the values. Never commit a real key.

# Claude API key from platform.claude.com, used only by the server route src/app/api/extract+api.js.
# No EXPO_PUBLIC_ prefix: that would put it inside the app.
ANTHROPIC_API_KEY=

# After deploying with EAS Hosting, the route's full address (this one is public, not secret), e.g.
# EXPO_PUBLIC_AI_PROXY_URL=https://your-project.expo.app/api/extract
EXPO_PUBLIC_AI_PROXY_URL=

# Optional shared app token: set BOTH to the same long random text. The server (AI_APP_TOKEN) then turns away requests
# that don't send it; the app (EXPO_PUBLIC_AI_APP_TOKEN) sends it. A deterrent only: the app's copy can be extracted.
# Leave both empty to switch the check off.
AI_APP_TOKEN=
EXPO_PUBLIC_AI_APP_TOKEN=
