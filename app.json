{
  "expo": {
    "name": "ShiftLime",
    "slug": "queuing-app",
    "version": "1.0.0",
    "scheme": "shiftlime",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAFCF4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shiftlime.app"
    },
    "android": {
      "package": "com.shiftlime.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3F7E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "@react-native-vector-icons/ionicons",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFCF4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F1611",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "163a6504-b533-49ab-937f-f71feea6c9c8"
      }
    }
  }
}
